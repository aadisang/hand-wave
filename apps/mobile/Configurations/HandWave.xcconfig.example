// Copy this file to HandWave.xcconfig and fill in your own values.
// HandWave.xcconfig is gitignored.

META_APP_ID = REPLACE_WITH_META_APP_ID
CLIENT_TOKEN = REPLACE_WITH_CLIENT_TOKEN
DEVELOPMENT_TEAM = REPLACE_WITH_TEAM_ID

// Debug builds use this local inference URL. Release builds always use
// https://handwave.sh so local endpoints are not shipped accidentally.
HANDWAVE_INFERENCE_URL = http:/$()/localhost:8000
