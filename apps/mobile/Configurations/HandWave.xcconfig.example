// Copy this file to HandWave.xcconfig to override local build settings.
// HandWave.xcconfig is optional and gitignored.

// Used by Release builds. Debug builds always use Developer Mode credentials.
META_APP_ID = REPLACE_WITH_META_APP_ID
CLIENT_TOKEN = REPLACE_WITH_CLIENT_TOKEN
DEVELOPMENT_TEAM = REPLACE_WITH_TEAM_ID

// Debug uses the cloud service by default. Uncomment to use a local server.
// Use your Mac's LAN address on an iPhone; localhost only works in the simulator.
// Release always uses the production inference service.
// HANDWAVE_INFERENCE_URL = http:/$()/localhost:8000
