opt_out_usage
require "json"
require "uri"

default_platform(:ios)

platform :ios do
  private_lane :release_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_API_PRIVATE_KEY"),
      duration: 1200
    )
  end

  desc "Build iOS for the backend verified by the release workflow"
  lane :build_release do
    manifest_path = File.expand_path("../../../.handwave/release.json", __dir__)
    manifest = JSON.parse(File.read(manifest_path))
    revision = sh("git rev-parse HEAD").strip
    unless manifest.fetch("deployment_id") == revision
      UI.user_error!("Backend and app must use the same commit")
    end
    unless manifest.fetch("environment") == "main"
      UI.user_error!("Release requires a production backend")
    end
    endpoint = URI.parse(manifest.fetch("url"))
    unless endpoint.scheme == "https" && endpoint.host && !endpoint.userinfo &&
        !endpoint.query && !endpoint.fragment && endpoint.path.empty?
      UI.user_error!("Release requires an HTTPS endpoint")
    end
    endpoint_file = File.expand_path("../Configurations/ReleaseEndpoint.xcconfig", __dir__)
    expected = "HANDWAVE_INFERENCE_URL = #{endpoint.to_s.sub('://', ':/$()/')}"
    unless File.readlines(endpoint_file).map(&:strip).include?(expected)
      UI.user_error!("Release endpoint does not match the verified backend")
    end
    app_identifier = "sh.handwave.HandWave"
    developer_team_id = "4PUCF2DKX4"
    profile_name = ENV.fetch("APPSTORE_PROFILE_NAME")

    api_key = release_api_key

    version = get_version_number(
      xcodeproj: "HandWave.xcodeproj",
      target: "HandWave"
    )
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: version,
      initial_build_number: 2
    ) + 1

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "HandWave.xcodeproj",
      team_id: developer_team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      build_configurations: ["Release"],
      targets: ["HandWave"]
    )

    build_app(
      workspace: "HandWave.xcworkspace",
      scheme: "HandWave",
      configuration: "Release",
      clean: true,
      output_directory: "Derived/TestFlight",
      output_name: "HandWave.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_method: "app-store",
      export_team_id: developer_team_id,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          app_identifier => profile_name
        }
      }
    )
  end

  desc "Publish the already-built iOS artifact after paired verification"
  lane :publish_release do
    upload_options = {
      api_key: release_api_key,
      app_identifier: "sh.handwave.HandWave",
      ipa: "Derived/TestFlight/HandWave.ipa",
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: false
    }
    changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").strip
    upload_options[:changelog] = changelog unless changelog.empty?

    upload_to_testflight(**upload_options)
  end
end
