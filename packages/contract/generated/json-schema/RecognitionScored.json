{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hand-wave.local/schemas/RecognitionScored.json",
    "type": "object",
    "properties": {
        "prediction": {
            "$ref": "https://hand-wave.local/schemas/Prediction.json"
        },
        "score": {
            "type": "number"
        },
        "source": {
            "$ref": "https://hand-wave.local/schemas/RecognitionSource.json"
        },
        "lm_score": {
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "type": "null"
                }
            ]
        },
        "model_agrees": {
            "type": "boolean"
        },
        "streak": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
        }
    },
    "required": [
        "prediction",
        "score",
        "source",
        "model_agrees",
        "streak"
    ]
}