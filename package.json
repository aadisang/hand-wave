{
  "name": "hand-wave",
  "private": true,
  "scripts": {
    "build": "moon run :build",
    "contract:regen": "moon run contract:cleanGenerated --force && moon run contract:generate --force",
    "check": "moon run :formatCheck :lint :typecheck :test contract:generatedCheck",
    "check:affected": "moon run :formatCheck :lint :typecheck :test --affected",
    "dev": "moon run :dev --quiet",
    "fix": "moon run :format :lintFix",
    "format": "moon run :format",
    "format:check": "moon run :formatCheck",
    "lint": "moon run :lint",
    "lint:fix": "moon run :lintFix",
    "test": "moon run :test",
    "typecheck": "moon run :typecheck"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.3.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "fast-json-patch@<3.1.1": ">=3.1.1",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "ip-address@<10.7.1": "10.7.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "shell-quote@>=1.1.0 <1.11.0": "1.11.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "postcss@<=8.5.22": "8.5.23",
      "tar@<=7.5.20": "7.5.21",
      "ajv-cli>js-yaml": "4.3.2",
      "@redocly/openapi-core>js-yaml": "4.3.2",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "basic-ftp@<6.2.1": "6.2.1",
      "tinypool@>=2.0.0 <2.1.2": "2.1.2"
    }
  }
}
