{
  "name": "hand-wave",
  "private": true,
  "scripts": {
    "build": "moon run :build",
    "contract:regen": "moon run contract:cleanGenerated && moon run contract:generate --force",
    "check": "moon run :formatCheck :lint :typecheck :test",
    "check:affected": "moon run :formatCheck :lint :typecheck :test --affected",
    "dev": "moon run :dev",
    "fix": "moon run :format :lintFix",
    "format": "moon run :format",
    "format:check": "moon run :formatCheck",
    "lint": "moon run :lint",
    "lint:fix": "moon run :lintFix",
    "test": "moon run :test",
    "typecheck": "moon run :typecheck"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "esbuild"
    ],
    "overrides": {
      "fast-json-patch@<3.1.1": ">=3.1.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "tar@<=7.5.15": ">=7.5.16",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "ajv-cli>js-yaml": "4.2.0",
      "@redocly/openapi-core>js-yaml": "4.2.0"
    }
  }
}
